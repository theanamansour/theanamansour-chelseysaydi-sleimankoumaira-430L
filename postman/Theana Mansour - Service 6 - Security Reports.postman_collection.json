{
  "info": {
    "_postman_id": "0f55da8c-bf08-456e-a54d-3a6ab0ed419d",
    "name": "Theana Mansour - Service 6 - Security Reports",
    "description": "Service 6 – Security Reports (by Theana Mansour)\n\nRun after the Service 1 collection, on the same database:\n\n1. load the sample data with `python -m services.reports.sample_data`\n    \n2. start Service 1 (port 5001) and Service 6 (port 5006)\n    \n3. set admin_login and admin_password in Variables\n    \n4. send the requests in order (0 to 29).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0- Login as admin (run this first)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login\": \"{{admin_login}}\",\n  \"password\": \"{{admin_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/theana-mansour/users/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "theana-mansour",
            "users",
            "login"
          ]
        },
        "description": "Logs in with admin_login / admin_password from the Variables and saves the token."
      },
      "response": []
    },
