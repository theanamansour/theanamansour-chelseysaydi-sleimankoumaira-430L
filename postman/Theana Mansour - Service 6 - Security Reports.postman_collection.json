      "name": "4- Admin gets the summary report",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Report has users, assets, open_incidents, critical_threats', function () { pm.expect(pm.response.json().data).to.include.all.keys(\"users\", \"assets\", \"open_incidents\", \"critical_threats\"); });"
            ]
